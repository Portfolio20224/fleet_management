# Copier en .env (ou exporter ces variables) — jamais de vraie valeur dans git.
# Sans aucune variable, le projet démarre en mode développement local.

# Base de données. Vide : SQLite local (db.sqlite3). Sur Render : remplie automatiquement.
# Ex. : postgresql://utilisateur:motdepasse@hote:5432/fleet
DATABASE_URL=

# 0 en production. En DEBUG=0, DJANGO_SECRET_KEY est obligatoire.
DJANGO_DEBUG=1
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domaines servis, séparés par des virgules (ex. fleet.mondomaine.cd)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS autorisées pour les formulaires (ex. https://fleet.mondomaine.cd)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production : redirection HTTPS (1) et durée HSTS en secondes (0 = désactivé)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=0
# Cookies réservés au HTTPS en production (0 uniquement pour un essai local en HTTP)
DJANGO_COOKIES_SECURISES=1
DJANGO_LOG_LEVEL=INFO

# Compte administrateur créé au démarrage s'il n'existe pas (commande creer_admin).
# Supprimez le mot de passe des variables une fois le compte créé.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Application
# Affiche les comptes de démo sur la page de connexion (par défaut = DJANGO_DEBUG)
FLEET_SHOW_DEMO_ACCOUNTS=
# Symbole de la monnaie affiché (franc congolais)
FLEET_DEVISE=FC
# Montant fixe pré-rempli dans la saisie percepteur (FC)
FLEET_MONTANT_FIXE_DEFAUT=100000
# Pointage : heure au-delà de laquelle l'arrivée est un retard
FLEET_HEURE_RETARD=07:30
# Pilotage RH / DG : âge de départ à la retraite et âge de renouvellement d'un véhicule
FLEET_AGE_RETRAITE=65
FLEET_AGE_RENOUVELLEMENT_VEHICULE=8
# Dossier des photos et captures envoyées (sur Render : chemin du disque persistant)
FLEET_MEDIA_ROOT=
# 1 = recharge les données de démo à chaque démarrage du conteneur (JAMAIS en production)
FLEET_SEED_DEMO=0
